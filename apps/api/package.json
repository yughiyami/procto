{
  "name": "@izumi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/src/server.js",
    "test": "tsx --env-file-if-exists=../../.env --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "admin:create": "tsx --env-file-if-exists=../../.env src/admin.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/seed-demo.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/cors": "^11.0.0",
    "pg": "^8.0.0",
    "zod": "^4.0.0",
    "ethers": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0"
  }
}
